# Credencial de Claude (NLP, OCR y Copilot). Sin ella, el servicio usa el parser de reglas.
ANTHROPIC_API_KEY=

# development | production (production oculta /docs y exige MONEYMAKER_APP_TOKEN)
MONEYMAKER_ENV=development

# auto (Claude si hay credenciales) | claude | rules
MONEYMAKER_AI_MODE=auto
MONEYMAKER_MODEL=claude-opus-5

# Token compartido que la app envía en el header X-MoneyMaker-Key. Vacío = sin verificación (solo desarrollo).
MONEYMAKER_APP_TOKEN=

# Archivo JSONL donde se acumulan las correcciones de categoría que los usuarios deciden compartir.
# Vacío = /v1/feedback responde 503 y no se guarda nada.
MONEYMAKER_FEEDBACK_PATH=

MONEYMAKER_DEFAULT_CURRENCY=COP
MONEYMAKER_MAX_IMAGE_MB=8
