<?xml version="1.0" encoding="utf-8"?>
<!-- Los datos financieros nunca viajan en los respaldos automáticos de Android:
     la sincronización ocurre solo con la nube privada que el usuario elija. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
